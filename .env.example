# Copy to .env and fill in. NEVER commit .env — the FalkorDB URL is a credential.

# ── Required ─────────────────────────────────────────────────────────
# Connection string from the FalkorDB Cloud UI.
# Local Docker fallback: redis://localhost:6379
FALKOR_URL=

# Password, pasted verbatim. Use this if your connection string does not
# already contain one (FalkorDB Cloud shows it separately), or if the password
# contains @ : / # ? or % — those break a URL unless percent-encoded.
FALKOR_PASSWORD=

# Only needed if your username is not already in FALKOR_URL.
FALKOR_USERNAME=

# Graph key the product uses. Tests use this value + "_test".
GRAPH_NAME=slackline

# ── API (apps/api) ───────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3001

# ── App shell only — NOT on the decision path (docs/kickoff.md 0.1) ──
# Phase 1 does not need these. The demo and the tests run without them.
MONGODB_URI=
JWT_SECRET=
