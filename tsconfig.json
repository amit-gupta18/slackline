{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@slackline/shared": ["packages/shared/src/index.ts"],
      "@slackline/graph": ["packages/graph/src/index.ts"],
      "@slackline/graph/*": ["packages/graph/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/mcp/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
